# Simulation mode for development, demos and load tests (ADR 0021): every registered aircraft
# is backed by a simulated one; operators see a SIMULATION banner. Never use in the field.
#   python -m uv run --env-file simulation.env fleet-service create-admin --username chief
#   python -m uv run --env-file simulation.env fleet-service
SARGCS_SIMULATION=true
SARGCS_DATA_DIR=data-sim
