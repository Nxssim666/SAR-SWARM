# LF everywhere in the repository and the working tree, regardless of core.autocrlf:
# shell scripts, Dockerfiles and PX4/ROS config break with CRLF inside Linux containers.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.mp4 binary
*.pmtiles binary
*.mbtiles binary
*.db binary
